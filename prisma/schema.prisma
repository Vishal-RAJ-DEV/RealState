generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  password        String?
  phone           String?
  image           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  emailVerified   DateTime?
  accounts        Account[]
  leads           Lead[]
  properties      Property[]
  savedProperties SavedProperty[]
  sessions        Session[]
}

model Property {
  id              String          @id @default(cuid())
  title           String
  description     String
  price           Float
  type            PropertyType
  listingFor      ListingFor
  city            String
  locality        String
  address         String?
  images          String[]
  status          Status          @default(ACTIVE)
  views           Int             @default(0)
  sellerId        String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  amenities       String[]        @default([])
  latitude        Float?
  longitude       Float?
  flatDetails     FlatDetails?
  leads           Lead[]
  pgDetails       PGDetails?
  plotDetails     PlotDetails?
  seller          User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  savedProperties SavedProperty[]
}

model PlotDetails {
  id                   String   @id @default(cuid())
  propertyId           String   @unique
  plotType             PlotType
  area                 Float
  areaUnit             String
  length               Float?
  width                Float?
  facing               String?
  roadWidth            Float?
  nearPlaces           String[]
  boundaryWall         Boolean  @default(false)
  waterAvailable       Boolean  @default(false)
  electricityAvailable Boolean  @default(false)
  property             Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model FlatDetails {
  id          String     @id @default(cuid())
  propertyId  String     @unique
  bedrooms    Int
  bathrooms   Int
  carpetArea  Float?
  builtUpArea Float?
  areaUnit    String?
  floor       Int?
  totalFloors Int?
  furnished   Furnished?
  facing      String?
  age         Int?
  balconies   Int?
  parking     Boolean    @default(false)
  roomSize    Json?
  property    Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PGDetails {
  id                String           @id @default(cuid())
  propertyId        String           @unique
  roomSize          Float?
  areaUnit          String?
  sharingType       SharingType
  totalBeds         Int?
  availableBeds     Int?
  genderPreference  GenderPreference
  attachedBathroom  Boolean          @default(false)
  balcony           Boolean          @default(false)
  furnished         Boolean          @default(false)
  foodAvailable     Boolean          @default(false)
  foodType          String?
  monthlyRent       Float
  securityDeposit   Float?
  maintenanceCharge Float?
  property          Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Lead {
  id         String   @id @default(cuid())
  propertyId String
  buyerId    String?
  name       String
  phone      String
  email      String
  message    String?
  createdAt  DateTime @default(now())
  buyer      User?    @relation(fields: [buyerId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model SavedProperty {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum PropertyType {
  FLAT
  PLOT
  PG_ROOM
}

enum ListingFor {
  SALE
  RENT
}

enum Furnished {
  UNFURNISHED
  SEMI
  FULLY
}

enum Status {
  ACTIVE
  SOLD
  RENTED
}

enum PlotType {
  RESIDENTIAL
  COMMERCIAL
  AGRICULTURAL
  INDUSTRIAL
}

enum SharingType {
  SINGLE
  DOUBLE
  TRIPLE
  FOUR
  FIVE_PLUS
}

enum GenderPreference {
  MALE
  FEMALE
  ANY
}
